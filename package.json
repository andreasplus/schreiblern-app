{
  "name": "schreiblern-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply schreiblern-app --local",
    "db:seed:local": "node scripts/seed.mjs --local",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply schreiblern-app --remote",
    "db:seed:remote": "node scripts/seed.mjs --remote",
    "compare:reference": "node scripts/compare-reference.mjs",
    "deploy": "wrangler deploy && npm run db:migrate:remote && npm run db:seed:remote",
    "test:e2e": "node scripts/e2e-print.mjs",
    "fonts:metrics": "python3 scripts/gen-font-metrics.py"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
