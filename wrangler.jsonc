{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schreiblern-app",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Damit auch ein reines `wrangler deploy` (z. B. Cloudflare Workers Builds ohne eigenen
  // Build-Befehl) zuerst Frontend und Worker baut.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Nötig für Vorschau-Deployments von Branches über Workers Builds (`wrangler preview`).
  "previews": {},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schreiblern-app",
      // Ohne database_id legt `wrangler deploy` die Datenbank beim ersten Deployment
      // automatisch an (automatische Ressourcenbereitstellung) und verwendet sie danach weiter.
      "migrations_dir": "migrations"
    }
  ]
}
